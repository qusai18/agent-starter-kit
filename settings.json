{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue comment:*)",
      "Bash(uv sync)",
      "Bash(uv run pytest:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(make test)",
      "Bash(make e2e)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(aws cloudformation delete-stack:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
